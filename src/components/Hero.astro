---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
}
const { src, alt, widths, sizes, eager = false } = Astro.props;
---

<div class="frame">
  {src && (
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
  )}
</div>

<style>
  .frame {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
