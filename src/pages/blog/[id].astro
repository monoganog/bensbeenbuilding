---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { title, date, summary } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={summary}>
  <article>
    <a class="back" href="/blog">← Blog</a>
    <h1>{title}</h1>
    <p class="muted">{formatDate(date)}</p>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  article { max-width: 720px; margin: 0 auto; }
  h1 { font-size: clamp(1.75rem, 4vw, 2.25rem); margin: 24px 0 4px; }
  p.muted { margin: 0 0 24px; }
</style>
